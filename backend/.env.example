# Required server settings
MONGO_URI=mongodb://127.0.0.1:27017/smartqueue
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
APP_TZ=Asia/Kolkata
ADMIN_REGISTRATION_CODE=generate-a-random-secret-and-share-securely

# Optional AI-written admin analytics summary (server-side only)
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=model-slug-from-openrouter

# Optional Brevo email and SMS when a student creates a token.
# Email uses the student's account address. SMS requires an opted-in student
# with an E.164 phone number saved in their Profile.
BREVO_API_KEY=your_v3_api_key
BREVO_SENDER_EMAIL=your_verified_sender@gmail.com
BREVO_SENDER_NAME=SmartQueue
BREVO_SMS_SENDER=SmartQ
